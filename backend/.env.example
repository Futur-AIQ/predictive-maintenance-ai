# ── Application ──────────────────────────────────────────────────────────────
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Passwords for the two seeded users (defaults: Admin@123 / Engineer@123).
# Always set these on a public deployment — the defaults are in the README.
# ADMIN_PASSWORD=
# ENGINEER_PASSWORD=

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/pm_system.db

# ── Vector Store ──────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db

# Embeddings: "sentence-transformers" (default) or "onnx" (same vectors, no
# torch, ~190 MB less RAM). Rebuild chroma_db if you switch.
# EMBEDDING_BACKEND=sentence-transformers
# Cross-encoder reranking; set false on low-memory hosts
# ENABLE_RERANKER=true

# ── LLM — Priority: OpenRouter → Anthropic → OpenAI ──────────────────────────
# 1. OpenRouter (primary)
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=your-openrouter-model-here

# 2. Anthropic (secondary)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# 3. OpenAI (fallback)
OPENAI_API_KEY=your-openai-api-key-here

# ── Data Paths ────────────────────────────────────────────────────────────────
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
